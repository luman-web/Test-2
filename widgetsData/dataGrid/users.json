    "activate": {
      "controlInfo": {
        "ajaxDataUrl": "",
        "className": "col-md-6",
        "customCode": "<b-button\r\n    v-if=\"rowData\"\r\n    variant=\"primary\"\r\n    size=\"sm\"\r\n    :disabled=\"Boolean(\r\n        (!rowData.user && rowData.eMail) ||\r\n        (rowData.user && $lodash.find(userList, { uid: rowData.user })) ||\r\n        $getGlobalModel('activateUser' + rowData.rowKey)\r\n    )\"\r\n    @click=\"\r\n        $setGlobalModel('activateUser' + rowData.rowKey, true);\r\n        $functions.httpsCallable(\r\n            (rowData.user && $lodash.find(userList, { uid: rowData.user }))\r\n            ? 'activateUserFromUserTable'\r\n            : 'addToDashboard'\r\n        )(\r\n            (rowData.user && $lodash.find(userList, { uid: rowData.user }))\r\n            ? {\r\n                dashId: currentDash,\r\n                rowData,\r\n                origin,\r\n            }\r\n            : {\r\n                uid: rowData.user,\r\n                dashboard: currentDash,\r\n                roles: rowData.role,\r\n                rules: rowData.accessRule\r\n            }\r\n        ).then((res) => {\r\n            $setGlobalModel('activateUser' + rowData.rowKey, false)\r\n\r\n            if (res.data && res.data.error) {\r\n                $bvToast.toast(\r\n                    res.data.error,\r\n                    {\r\n                        title: 'Error!',\r\n                        variant: 'danger',\r\n                        solid: true,\r\n                        toaster: 'b-toaster-top-center',\r\n                        autoHideDelay: 2500,\r\n                    }\r\n                )\r\n            } else {\r\n                $getUserList()\r\n            }\r\n        }).catch(() => {\r\n            $setGlobalModel('activateUser' + rowData.rowKey, false)\r\n        });\r\n    \"\r\n>\r\n    <b-spinner small v-if=\"$getGlobalModel('activateUser' + rowData.rowKey)\" />\r\n    <span v-if=\"!rowData.user || !$lodash.find(userList, { uid: rowData.user })\">Activate</span>\r\n    <span v-else>Activated</span>\r\n</b-button>\r\n",
